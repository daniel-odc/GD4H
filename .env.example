# Copy this file to .env.local and fill in the values (.env.local is not committed).
# Variables prefixed with REACT_APP_ are available in the code as process.env.REACT_APP_* (see vite.config.js).
# Note: they are embedded in the built JavaScript, so they are visible to anyone using the app.

# CARTO basemaps API key (free: https://carto.com/basemaps/apikey). Without it, the map uses OpenStreetMap tiles.
REACT_APP_CARTO_API_KEY=

# Base URL of the application
REACT_APP_BASE_APP_URL=

# Folder URL of the GIS layers (regions.json, departements.json, communes.json), e.g.
# https://storage.googleapis.com/public-bucket-odc-data/geodata/France/
REACT_APP_BUCKET_GEODATA=
